{
  "name": "@ipfans/dsh-purge-rebuild",
  "version": "1.1.72",
  "description": "DeepSeek Harness plugin for host patches, prompts, rules, skills, and authorized security drills.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipfans/dsh-purge-rebuild.git"
  },
  "homepage": "https://github.com/ipfans/dsh-purge-rebuild#readme",
  "bugs": {
    "url": "https://github.com/ipfans/dsh-purge-rebuild/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/ipfans/dsh-purge-rebuild/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/ipfans/dsh-purge-rebuild/archive/refs/heads/master.zip",
      "git": "https://github.com/ipfans/dsh-purge-rebuild.git"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2"
}
